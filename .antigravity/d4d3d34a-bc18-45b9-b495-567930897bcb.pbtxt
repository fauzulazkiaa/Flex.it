    absolute_path_uri: "file:///src/components/StatCards.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  Trophy, \n  Calendar, \n  Clock, \n  CheckCircle2, \n  AlertCircle, \n  XCircle, \n  BookCheck, \n  Target\n} from \'lucide-react\';\nimport { Activity } from \'../types\';\nimport { getDaysRemaining } from \'../utils/storage\';\n\ninterface StatCardsProps {\n  activities: Activity[];\n  selectedYear: string;\n}\n\nexport const StatCards: React.FC<StatCardsProps> = ({ activities, selectedYear }) => {\n  // Filter berdasarkan tahun jika ada\n  const filteredActivities = selectedYear === \'ALL\' \n    ? activities \n    : activities.filter(a => a.year.toString() === selectedYear);\n\n  const totalThisYear = filteredActivities.length;\n\n  const countBelum = filteredActivities.filter(a => a.status === \'BELUM_DAFTAR\').length;\n  const countSudah = filteredActivities.filter(a => a.status === \'SUDAH_DAFTAR\').length;\n  const countLolos = filteredActivities.filter(a => a.status === \'LOLOS\').length;\n  const countTidakLolos = filteredActivities.filter(a => a.status === \'TIDAK_LOLOS\').length;\n  const countSelesai = filteredActivities.filter(a => a.status === \'SELESAI\').length;\n\n  // Success rate: (Lolos + Selesai) / Total kegiatan yang sudah diproses pengumumannya (Lolos + Tidak Lolos + Selesai)\n  const processedCount = countLolos + countTidakLolos + countSelesai;\n  const successCount = countLolos + countSelesai;\n  const successRate = processedCount > 0 ? Math.round((successCount / processedCount) * 100) : 0;\n\n  // Upcoming deadlines in < 14 days\n  const upcomingCount = filteredActivities.filter(a => {\n    if (a.status === \'SELESAI\' || a.status === \'TIDAK_LOLOS\') return false;\n    const daysInfo = getDaysRemaining(a.regDeadline);\n    return daysInfo && daysInfo.status !== \'overdue\' && daysInfo.days <= 14;\n  }).length;\n\n  return (\n    <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n      \n      {/* 1. Total Kegiatan */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-xs relative overflow-hidden group hover:border-blue-300 dark:hover:border-blue-800 transition\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <p className=\"text-xs font-semibold tracking-wider text-slate-500 dark:text-slate-400 uppercase\">\n              Total Kegiatan {selectedYear !== \'ALL\' ? `(${selectedYear})` : \'\'}\n            </p>\n            <h3 className=\"text-3xl font-extrabold text-slate-900 dark:text-white mt-1\">\n              {totalThisYear}\n            </h3>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n              {countSudah + countBelum} aktif \342\200\242 {processedCount} selesai/hasil\n            </p>\n          </div>\n          <div className=\"w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold\">\n            <Calendar className=\"w-6 h-6\" />\n          </div>\n        </div>\n        <div className=\"mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-600 dark:text-slate-400\">\n          <span className=\"flex items-center gap-1 font-medium\">\n            <BookCheck className=\"w-3.5 h-3.5 text-blue-500\" /> {countSudah} Terdaftar\n          </span>\n          <span className=\"flex items-center gap-1 font-medium\">\n            <Clock className=\"w-3.5 h-3.5 text-slate-400\" /> {countBelum} Belum Daftar\n          </span>\n        </div>\n      </div>\n\n      {/* 2. Success Rate / Persentase Lolos */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-xs relative overflow-hidden group hover:border-emerald-300 dark:hover:border-emerald-800 transition\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <p className=\"text-xs font-semibold tracking-wider text-slate-500 dark:text-slate-400 uppercase\">\n              Success Rate (Lolos/Menang)\n            </p>\n            <div className=\"flex items-baseline gap-2 mt-1\">\n              <h3 className=\"text-3xl font-extrabold text-slate-900 dark:text-white\">\n                {successRate}%\n              </h3>\n              <span className=\"text-xs font-medium text-emerald-600 dark:text-emerald-400\">\n                ({successCount}/{processedCount} program)\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n              {countLolos} Lolos \342\200\242 {countSelesai} Selesai \342\200\242 {countTidakLolos} Evaluasi\n            </p>\n          </div>\n          <div className=\"w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold\">\n            <Trophy className=\"w-6 h-6\" />\n          </div>\n        </div>\n        \n        {/* Progress Bar Mini */}\n        <div className=\"mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80\">\n          <div className=\"w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden\">\n            <div \n              className=\"bg-emerald-500 h-full rounded-full transition-all duration-500\"\n              style={{ width: `${successRate}%` }}\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* 3. Upcoming Deadlines */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-xs relative overflow-hidden group hover:border-amber-300 dark:hover:border-amber-800 transition\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <p className=\"text-xs font-semibold tracking-wider text-slate-500 dark:text-slate-400 uppercase\">\n              Upcoming Deadlines\n            </p>\n            <h3 className=\"text-3xl font-extrabold text-slate-900 dark:text-white mt-1\">\n              {upcomingCount}\n            </h3>\n            <p className=\"text-xs text-amber-600 dark:text-amber-400 font-medium mt-1\">\n              Tenggat waktu &lt; 14 hari kedepan\n            </p>\n          </div>\n          <div className=\"w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold\">\n            <AlertCircle className=\"w-6 h-6\" />\n          </div>\n        </div>\n        <div className=\"mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-600 dark:text-slate-400\">\n          <span className=\"text-slate-500\">Persiapkan berkas & submit tepat waktu</span>\n        </div>\n      </div>\n\n      {/* 4. Status Overview Pill Counts */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-xs relative overflow-hidden group hover:border-indigo-300 dark:hover:border-indigo-800 transition\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <p className=\"text-xs font-semibold tracking-wider text-slate-500 dark:text-slate-400 uppercase\">\n            Ringkasan Status\n          </p>\n          <div className=\"w-8 h-8 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center\">\n            <Target className=\"w-4 h-4\" />\n          </div>\n        </div>\n        \n        <div className=\"grid grid-cols-2 gap-2 text-xs\">\n          <div className=\"flex items-center justify-between p-1.5 rounded-lg bg-emerald-50/60 dark:bg-emerald-950/30 border border-emerald-100 dark:border-emerald-900/50\">\n            <span className=\"flex items-center gap-1 font-medium text-emerald-700 dark:text-emerald-400\">\n              <CheckCircle2 className=\"w-3 h-3\" /> Lolos\n            </span>\n            <span className=\"font-bold text-emerald-800 dark:text-emerald-300\">{countLolos}</span>\n          </div>\n\n          <div className=\"flex items-center justify-between p-1.5 rounded-lg bg-blue-50/60 dark:bg-blue-950/30 border border-blue-100 dark:border-blue-900/50\">\n            <span className=\"flex items-center gap-1 font-medium text-blue-700 dark:text-blue-400\">\n              <BookCheck className=\"w-3 h-3\" /> Daftar\n            </span>\n            <span className=\"font-bold text-blue-800 dark:text-blue-300\">{countSudah}</span>\n          </div>\n\n          <div className=\"flex items-center justify-between p-1.5 rounded-lg bg-teal-50/60 dark:bg-teal-950/30 border border-teal-100 dark:border-teal-900/50\">\n            <span className=\"flex items-center gap-1 font-medium text-teal-700 dark:text-teal-400\">\n              <CheckCircle2 className=\"w-3 h-3\" /> Selesai\n            </span>\n            <span className=\"font-bold text-teal-800 dark:text-teal-300\">{countSelesai}</span>\n          </div>\n\n          <div className=\"flex items-center justify-between p-1.5 rounded-lg bg-rose-50/60 dark:bg-rose-950/30 border border-rose-100 dark:border-rose-900/50\">\n            <span className=\"flex items-center gap-1 font-medium text-rose-700 dark:text-rose-400\">\n              <XCircle className=\"w-3 h-3\" /> Evaluasi\n            </span>\n            <span className=\"font-bold text-rose-800 dark:text-rose-300\">{countTidakLolos}</span>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    }
