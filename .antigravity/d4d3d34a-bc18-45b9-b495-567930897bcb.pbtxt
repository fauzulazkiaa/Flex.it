      original_chunk {
        target_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto\">\n      <div className=\"bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl w-full max-w-lg overflow-hidden my-8 animate-in fade-in zoom-in duration-200\">\n        \n        {/* Header */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold\">\n              <Tag className=\"w-4 h-4\" />\n            </div>\n            <h3 className=\"font-bold text-slate-900 dark:text-white text-base\">\n              Manajemen Kategori Kegiatan\n            </h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-slate-700 transition\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-6 space-y-4 text-xs sm:text-sm\">\n          \n          {editingCat ? (\n            <form onSubmit={handleSave} className=\"p-4 rounded-2xl bg-purple-50/50 dark:bg-purple-950/20 border border-purple-200 dark:border-purple-800 space-y-3\">\n              <h4 className=\"font-bold text-purple-900 dark:text-purple-200 text-xs uppercase tracking-wider\">\n                {editingCat.id ? \'Edit Kategori\' : \'Tambah Kategori Baru\'}\n              </h4>\n\n              <div className=\"space-y-1\">\n                <label className=\"font-semibold text-slate-700 dark:text-slate-300\">Nama Kategori</label>\n                <input\n                  type=\"text\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  placeholder=\"Misal: Robotics, Volunteer, dsb.\"\n                  required\n                  className=\"w-full px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500\"\n                />\n              </div>\n\n              <div className=\"space-y-1\">\n                <label className=\"font-semibold text-slate-700 dark:text-slate-300\">Keterangan / Deskripsi</label>\n                <input\n                  type=\"text\"\n                  value={description}\n                  onChange={(e) => setDescription(e.target.value)}\n                  placeholder=\"Penjelasan singkat tipe kegiatan...\"\n                  className=\"w-full px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white\"\n                />\n              </div>\n\n              <div className=\"flex items-center justify-end gap-2 pt-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setEditingCat(null)}\n                  className=\"px-3 py-1.5 rounded-xl text-slate-600 dark:text-slate-400 font-medium hover:bg-slate-200/60 transition\"\n                >\n                  Batal\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"inline-flex items-center gap-1 px-4 py-1.5 rounded-xl font-bold text-white bg-purple-600 hover:bg-purple-700 transition shadow-xs\"\n                >\n                  <Save className=\"w-3.5 h-3.5\" />\n                  Simpan\n                </button>\n              </div>\n            </form>\n          ) : (\n            <div className=\"flex justify-between items-center\">\n              <span className=\"text-slate-500 text-xs\">Total {categories.length} Kategori Terdaftar</span>\n              <button\n                onClick={startCreate}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 transition\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                Tambah Kategori\n              </button>\n            </div>\n          )}\n\n          {/* List of categories */}\n          <div className=\"space-y-2 max-h-72 overflow-y-auto pr-1\">\n            {categories.map((cat) => (\n              <div\n                key={cat.id}\n                className=\"flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-700/70\"\n              >\n                <div>\n                  <h4 className=\"font-bold text-slate-900 dark:text-white text-xs sm:text-sm\">{cat.name}</h4>\n                  {cat.description && (\n                    <p className=\"text-[11px] text-slate-500 dark:text-slate-400 mt-0.5\">{cat.description}</p>\n                  )}\n                </div>\n\n                <div className=\"flex items-center gap-1\">\n                  <button\n                    onClick={() => startEdit(cat)}\n                    className=\"p-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-700 transition\"\n                  >\n                    <Edit3 className=\"w-3.5 h-3.5\" />\n                  </button>\n                  <button\n                    onClick={() => {\n                      if (categories.length <= 1) {\n                        alert(\'Minimal harus ada 1 kategori!\');\n                        return;\n                      }\n                      if (confirm(`Hapus kategori \"${cat.name}\"?`)) {\n                        onDeleteCategory(cat.id);\n                      }\n                    }}\n                    className=\"p-1.5 rounded-lg text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-xl text-xs font-semibold text-white bg-slate-900 dark:bg-slate-700 hover:bg-slate-800 transition\"\n          >\n            Selesai\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm overflow-y-auto\">\n      <div className=\"bg-[#0c0c0e] rounded-3xl border border-zinc-800/90 shadow-2xl w-full max-w-lg overflow-hidden my-8 animate-in fade-in zoom-in duration-200\">\n        \n        {/* Header */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-zinc-800/80 bg-[#121215]\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-xl bg-violet-500/10 border border-violet-500/20 text-violet-400 flex items-center justify-center font-bold\">\n              <Tag className=\"w-4 h-4\" />\n            </div>\n            <h3 className=\"font-extrabold text-zinc-100 text-base\">\n              Manajemen Kategori Kegiatan\n            </h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-zinc-400 hover:text-zinc-100 p-1.5 rounded-xl hover:bg-zinc-800 transition cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-6 space-y-4 text-xs sm:text-sm\">\n          \n          {editingCat ? (\n            <form onSubmit={handleSave} className=\"p-4 rounded-2xl bg-violet-950/20 border border-violet-800/60 space-y-3\">\n              <h4 className=\"font-bold text-violet-300 text-xs uppercase tracking-wider\">\n                {editingCat.id ? \'Edit Kategori\' : \'Tambah Kategori Baru\'}\n              </h4>\n\n              <div className=\"space-y-1\">\n                <label className=\"font-semibold text-zinc-300\">Nama Kategori</label>\n                <input\n                  type=\"text\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  placeholder=\"Misal: Robotics, Volunteer, dsb.\"\n                  required\n                  className=\"w-full px-3 py-1.5 rounded-xl bg-[#0c0c0e] border border-zinc-800 text-zinc-100 focus:outline-none focus:border-indigo-500 placeholder-zinc-500\"\n                />\n              </div>\n\n              <div className=\"space-y-1\">\n                <label className=\"font-semibold text-zinc-300\">Keterangan / Deskripsi</label>\n                <input\n                  type=\"text\"\n                  value={description}\n                  onChange={(e) => setDescription(e.target.value)}\n                  placeholder=\"Penjelasan singkat tipe kegiatan...\"\n                  className=\"w-full px-3 py-1.5 rounded-xl bg-[#0c0c0e] border border-zinc-800 text-zinc-100 placeholder-zinc-500\"\n                />\n              </div>\n\n              <div className=\"flex items-center justify-end gap-2 pt-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setEditingCat(null)}\n                  className=\"px-3 py-1.5 rounded-xl text-zinc-400 font-medium hover:bg-zinc-800 hover:text-zinc-100 transition cursor-pointer\"\n                >\n                  Batal\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"inline-flex items-center gap-1 px-4 py-1.5 rounded-xl font-bold text-white bg-violet-600 hover:bg-violet-500 transition shadow-lg cursor-pointer\"\n                >\n                  <Save className=\"w-3.5 h-3.5\" />\n                  Simpan\n                </button>\n              </div>\n            </form>\n          ) : (\n            <div className=\"flex justify-between items-center\">\n              <span className=\"text-zinc-400 text-xs\">Total {categories.length} Kategori Terdaftar</span>\n              <button\n                onClick={startCreate}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 transition cursor-pointer\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                Tambah Kategori\n              </button>\n            </div>\n          )}\n\n          {/* List of categories */}\n          <div className=\"space-y-2 max-h-72 overflow-y-auto pr-1\">\n            {categories.map((cat) => (\n              <div\n                key={cat.id}\n                className=\"flex items-center justify-between p-3 rounded-xl bg-[#121215] border border-zinc-800\"\n              >\n                <div>\n                  <h4 className=\"font-bold text-zinc-100 text-xs sm:text-sm\">{cat.name}</h4>\n                  {cat.description && (\n                    <p className=\"text-[11px] text-zinc-400 mt-0.5\">{cat.description}</p>\n                  )}\n                </div>\n\n                <div className=\"flex items-center gap-1\">\n                  <button\n                    onClick={() => startEdit(cat)}\n                    className=\"p-1.5 rounded-lg text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 transition cursor-pointer\"\n                  >\n                    <Edit3 className=\"w-3.5 h-3.5\" />\n                  </button>\n                  <button\n                    onClick={() => {\n                      if (categories.length <= 1) {\n                        alert(\'Minimal harus ada 1 kategori!\');\n                        return;\n                      }\n                      if (confirm(`Hapus kategori \"${cat.name}\"?`)) {\n                        onDeleteCategory(cat.id);\n                      }\n                    }}\n                    className=\"p-1.5 rounded-lg text-rose-400 hover:bg-rose-950/40 transition cursor-pointer\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-4 border-t border-zinc-800/80 bg-[#121215] flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-xl text-xs font-semibold text-zinc-200 bg-zinc-800 hover:bg-zinc-700 transition cursor-pointer\"\n          >\n            Selesai\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
