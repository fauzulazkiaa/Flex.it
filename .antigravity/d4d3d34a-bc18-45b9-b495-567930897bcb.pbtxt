    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto\">\n      <div className=\"bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl w-full max-w-2xl overflow-hidden my-8 animate-in fade-in zoom-in duration-200\">\n        \n        {/* Header Modal */}\n        <div className=\"flex items-start justify-between p-6 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40\">\n          <div className=\"space-y-2 max-w-lg\">\n            <div className=\"flex items-center gap-2 flex-wrap\">\n              {categoryObj && (\n                <span className=\"px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800\">\n                  {categoryObj.name}\n                </span>\n              )}\n              <span className={`px-2.5 py-0.5 rounded-full text-xs font-semibold border ${statusStyle.bg} ${statusStyle.text} ${statusStyle.border}`}>\n                {statusStyle.label}\n              </span>\n              <span className=\"text-xs text-slate-400 font-medium\">Tahun {activity.year}</span>\n            </div>\n\n            <h2 className=\"text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white leading-tight\">\n              {activity.title}\n            </h2>\n\n            {activity.organizer && (\n              <p className=\"text-xs sm:text-sm text-slate-500 dark:text-slate-400 flex items-center gap-1.5 font-medium\">\n                <Building2 className=\"w-4 h-4 text-slate-400\" /> Penyelenggara: {activity.organizer}\n              </p>\n            )}\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-2 rounded-xl hover:bg-slate-200/60 dark:hover:bg-slate-700 transition\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6 space-y-6 text-xs sm:text-sm\">\n          \n          {/* Quick Status Updater Dropdown */}\n          <div className=\"flex items-center justify-between p-3.5 rounded-2xl bg-blue-50/70 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900/60\">\n            <span className=\"font-semibold text-blue-900 dark:text-blue-200 flex items-center gap-1.5 text-xs\">\n              <CheckCircle2 className=\"w-4 h-4 text-blue-600 dark:text-blue-400\" /> Ubah Status Pendaftaran:\n            </span>\n            <select\n              value={activity.status}\n              onChange={(e) => onUpdateStatus(activity.id, e.target.value as StatusPendaftaran)}\n              className=\"text-xs font-bold px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-blue-200 dark:border-blue-800 text-slate-800 dark:text-slate-200 outline-none cursor-pointer\"\n            >\n              <option value=\"BELUM_DAFTAR\">Belum Daftar</option>\n              <option value=\"SUDAH_DAFTAR\">Sudah Daftar</option>\n              <option value=\"LOLOS\">Lolos</option>\n              <option value=\"TIDAK_LOLOS\">Tidak Lolos</option>\n              <option value=\"SELESAI\">Selesai</option>\n            </select>\n          </div>\n\n          {/* Timeline Dates */}\n          <div className=\"p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 space-y-3\">\n            <h4 className=\"font-bold text-slate-900 dark:text-white text-xs uppercase tracking-wider flex items-center gap-1.5\">\n              <Calendar className=\"w-4 h-4 text-blue-500\" /> Timeline & Tanggal Penting\n            </h4>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs\">\n              \n              <div className=\"p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/70 dark:border-slate-700\">\n                <p className=\"text-slate-400 text-[11px] font-medium\">Deadline Pendaftaran</p>\n                <p className=\"font-bold text-slate-900 dark:text-white mt-0.5\">{formatDateIndo(activity.regDeadline)}</p>\n                {daysInfo && (\n                  <p className=\"text-[10px] text-blue-600 font-semibold mt-0.5\">\n                    {daysInfo.status === \'today\' ? \'Hari ini!\' : daysInfo.status === \'upcoming\' ? `${daysInfo.days} hari lagi` : \'Selesai\'}\n                  </p>\n                )}\n              </div>\n\n              <div className=\"p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/70 dark:border-slate-700\">\n                <p className=\"text-slate-400 text-[11px] font-medium\">Deadline Submit</p>\n                <p className=\"font-bold text-slate-900 dark:text-white mt-0.5\">{formatDateIndo(activity.submitDeadline)}</p>\n              </div>\n\n              <div className=\"p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/70 dark:border-slate-700\">\n                <p className=\"text-slate-400 text-[11px] font-medium\">Pengumuman</p>\n                <p className=\"font-bold text-slate-900 dark:text-white mt-0.5\">{formatDateIndo(activity.announcementDate)}</p>\n              </div>\n\n              <div className=\"p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/70 dark:border-slate-700\">\n                <p className=\"text-slate-400 text-[11px] font-medium\">Pelaksanaan</p>\n                <p className=\"font-bold text-slate-900 dark:text-white mt-0.5\">{formatDateIndo(activity.eventDate)}</p>\n              </div>\n\n            </div>\n          </div>\n\n          {/* Detail & Benefit Teks */}\n          <div className=\"space-y-1.5\">\n            <h4 className=\"font-bold text-slate-900 dark:text-white text-xs uppercase tracking-wider\">\n              Detail, Benefit & Catatan\n            </h4>\n            <div className=\"p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-line\">\n              {activity.details || \'Tidak ada catatan detail tambahan.\'}\n            </div>\n          </div>\n\n          {/* Tautan Berkas & Arsip (Google Drive / Submit / Berkas) */}\n          <div className=\"space-y-2\">\n            <h4 className=\"font-bold text-slate-900 dark:text-white text-xs uppercase tracking-wider\">\n              Tautan Berkas & Pengarsipan Sertifikat\n            </h4>\n\n            <div className=\"space-y-2\">\n              \n              {/* Google Drive */}\n              {activity.driveUrl ? (\n                <div className=\"flex items-center justify-between p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800\">\n                  <div className=\"flex items-center gap-2 overflow-hidden mr-2\">\n                    <FolderGit2 className=\"w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0\" />\n                    <div>\n                      <p className=\"font-bold text-emerald-900 dark:text-emerald-300 text-xs\">Drive Sertifikat / Hasil</p>\n                      <p className=\"text-[11px] text-emerald-700 dark:text-emerald-400 truncate max-w-xs\">{activity.driveUrl}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-1 shrink-0\">\n                    <button\n                      onClick={() => copyToClipboard(activity.driveUrl!, \'drive\')}\n                      className=\"p-1.5 rounded-lg bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 transition\"\n                      title=\"Salin Tautan\"\n                    >\n                      {copiedLink === \'drive\' ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    </button>\n                    <a\n                      href={activity.driveUrl}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition\"\n                    >\n                      Buka Drive <ExternalLink className=\"w-3 h-3\" />\n                    </a>\n                  </div>\n                </div>\n              ) : null}\n\n              {/* Submission Url */}\n              {activity.submissionUrl ? (\n                <div className=\"flex items-center justify-between p-3 rounded-xl bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800\">\n                  <div className=\"flex items-center gap-2 overflow-hidden mr-2\">\n                    <FileCheck2 className=\"w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0\" />\n                    <div>\n                      <p className=\"font-bold text-blue-900 dark:text-blue-300 text-xs\">Tautan Submit Karya</p>\n                      <p className=\"text-[11px] text-blue-700 dark:text-blue-400 truncate max-w-xs\">{activity.submissionUrl}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-1 shrink-0\">\n                    <button\n                      onClick={() => copyToClipboard(activity.submissionUrl!, \'submit\')}\n                      className=\"p-1.5 rounded-lg bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 transition\"\n                      title=\"Salin Tautan\"\n                    >\n                      {copiedLink === \'submit\' ? <Check className=\"w-3.5 h-3.5 text-blue-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    </button>\n                    <a\n                      href={activity.submissionUrl}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 transition\"\n                    >\n                      Buka Link <ExternalLink className=\"w-3 h-3\" />\n                    </a>\n                  </div>\n                </div>\n              ) : null}\n\n              {/* Documents Url */}\n              {activity.documentsUrl ? (\n                <div className=\"flex items-center justify-between p-3 rounded-xl bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800\">\n                  <div className=\"flex items-center gap-2 overflow-hidden mr-2\">\n                    <ExternalLink className=\"w-4 h-4 text-purple-600 dark:text-purple-400 shrink-0\" />\n                    <div>\n                      <p className=\"font-bold text-purple-900 dark:text-purple-300 text-xs\">Berkas Persyaratan</p>\n                      <p className=\"text-[11px] text-purple-700 dark:text-purple-400 truncate max-w-xs\">{activity.documentsUrl}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-1 shrink-0\">\n                    <button\n                      onClick={() => copyToClipboard(activity.documentsUrl!, \'docs\')}\n                      className=\"p-1.5 rounded-lg bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 transition\"\n                      title=\"Salin Tautan\"\n                    >\n                      {copiedLink === \'docs\' ? <Check className=\"w-3.5 h-3.5 text-purple-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    </button>\n                    <a\n                      href={activity.documentsUrl}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-purple-600 hover:bg-purple-700 transition\"\n                    >\n                      Buka Link <ExternalLink className=\"w-3 h-3\" />\n                    </a>\n                  </div>\n                </div>\n              ) : null}\n\n              {!activity.driveUrl && !activity.submissionUrl && !activity.documentsUrl && (\n                <div className=\"p-4 text-center text-xs text-slate-400 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-dashed border-slate-200 dark:border-slate-800\">\n                  Belum ada tautan berkas atau sertifikat yang diunggah. Klik edit untuk menambahkan URL Google Drive.\n                </div>\n              )}\n\n            </div>\n          </div>\n\n          {/* Tags */}\n          {activity.tags && activity.tags.length > 0 && (\n            <div className=\"flex items-center gap-2 flex-wrap pt-2\">\n              <span className=\"text-xs font-semibold text-slate-400 flex items-center gap-1\">\n                <Tag className=\"w-3.5 h-3.5\" /> Label Tag:\n              </span>\n              {activity.tags.map((tag, idx) => (\n                <span key={idx} className=\"px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300\">\n                  #{tag}\n                </span>\n              ))}\n            </div>\n          )}\n\n        </div>\n\n        {/* Modal Footer Actions */}\n        <div className=\"flex items-center justify-between p-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40\">\n          <button\n            onClick={() => {\n              if (confirm(`Hapus kegiatan \"${activity.title}\"?`)) {\n                onDelete(activity.id);\n                onClose();\n              }\n            }}\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition\"\n          >\n            <Trash2 className=\"w-4 h-4\" />\n            <span>Hapus Kegiatan</span>\n          </button>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => {\n                onClose();\n                onEdit(activity);\n              }}\n              className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800 hover:bg-blue-100 transition\"\n            >\n              <Edit className=\"w-4 h-4\" />\n              <span>Edit Data</span>\n            </button>\n            <button\n              onClick={onClose}\n              className=\"px-4 py-2 rounded-xl text-xs font-semibold text-white bg-slate-900 dark:bg-slate-700 hover:bg-slate-800 transition\"\n            >\n              Tutup\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm overflow-y-auto\">\n      <div className=\"bg-[#0c0c0e] rounded-3xl border border-zinc-800/90 shadow-2xl w-full max-w-2xl overflow-hidden my-8 animate-in fade-in zoom-in duration-200\">\n        \n        {/* Header Modal */}\n        <div className=\"flex items-start justify-between p-6 border-b border-zinc-800/80 bg-[#121215]\">\n          <div className=\"space-y-2 max-w-lg\">\n            <div className=\"flex items-center gap-2 flex-wrap\">\n              {categoryObj && (\n                <span className=\"px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-950/80 text-indigo-300 border border-indigo-800\">\n                  {categoryObj.name}\n                </span>\n              )}\n              <span className={`px-2.5 py-0.5 rounded-full text-xs font-semibold border ${statusStyle.bg} ${statusStyle.text} ${statusStyle.border}`}>\n                {statusStyle.label}\n              </span>\n              <span className=\"text-xs text-zinc-400 font-medium\">Tahun {activity.year}</span>\n            </div>\n\n            <h2 className=\"text-xl sm:text-2xl font-extrabold text-zinc-100 leading-tight\">\n              {activity.title}\n            </h2>\n\n            {activity.organizer && (\n              <p className=\"text-xs sm:text-sm text-zinc-400 flex items-center gap-1.5 font-medium\">\n                <Building2 className=\"w-4 h-4 text-zinc-500\" /> Penyelenggara: {activity.organizer}\n              </p>\n            )}\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"text-zinc-400 hover:text-zinc-100 p-2 rounded-xl hover:bg-zinc-800 transition cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6 space-y-6 text-xs sm:text-sm\">\n          \n          {/* Quick Status Updater Dropdown */}\n          <div className=\"flex items-center justify-between p-3.5 rounded-2xl bg-[#121215] border border-indigo-900/40\">\n            <span className=\"font-semibold text-indigo-300 flex items-center gap-1.5 text-xs\">\n              <CheckCircle2 className=\"w-4 h-4 text-indigo-400\" /> Ubah Status Pendaftaran:\n            </span>\n            <select\n              value={activity.status}\n              onChange={(e) => onUpdateStatus(activity.id, e.target.value as StatusPendaftaran)}\n              className=\"text-xs font-bold px-3 py-1.5 rounded-xl bg-[#0c0c0e] border border-indigo-800 text-zinc-100 outline-none cursor-pointer\"\n            >\n              <option value=\"BELUM_DAFTAR\" className=\"bg-zinc-900 text-zinc-100\">Belum Daftar</option>\n              <option value=\"SUDAH_DAFTAR\" className=\"bg-zinc-900 text-zinc-100\">Sudah Daftar</option>\n              <option value=\"LOLOS\" className=\"bg-zinc-900 text-zinc-100\">Lolos</option>\n              <option value=\"TIDAK_LOLOS\" className=\"bg-zinc-900 text-zinc-100\">Tidak Lolos</option>\n              <option value=\"SELESAI\" className=\"bg-zinc-900 text-zinc-100\">Selesai</option>\n            </select>\n          </div>\n\n          {/* Timeline Dates */}\n          <div className=\"p-4 rounded-2xl bg-[#121215] border border-zinc-800/80 space-y-3\">\n            <h4 className=\"font-bold text-zinc-100 text-xs uppercase tracking-wider flex items-center gap-1.5\">\n              <Calendar className=\"w-4 h-4 text-indigo-400\" /> Timeline & Tanggal Penting\n            </h4>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs\">\n              \n              <div className=\"p-2.5 rounded-xl bg-[#0c0c0e] border border-zinc-800\">\n                <p className=\"text-zinc-400 text-[11px] font-medium\">Deadline Pendaftaran</p>\n                <p className=\"font-bold text-zinc-100 mt-0.5\">{formatDateIndo(activity.regDeadline)}</p>\n                {daysInfo && (\n                  <p className=\"text-[10px] text-indigo-400 font-semibold mt-0.5\">\n                    {daysInfo.status === \'today\' ? \'Hari ini!\' : daysInfo.status === \'upcoming\' ? `${daysInfo.days} hari lagi` : \'Selesai\'}\n                  </p>\n                )}\n              </div>\n\n              <div className=\"p-2.5 rounded-xl bg-[#0c0c0e] border border-zinc-800\">\n                <p className=\"text-zinc-400 text-[11px] font-medium\">Deadline Submit</p>\n                <p className=\"font-bold text-zinc-100 mt-0.5\">{formatDateIndo(activity.submitDeadline)}</p>\n              </div>\n\n              <div className=\"p-2.5 rounded-xl bg-[#0c0c0e] border border-zinc-800\">\n                <p className=\"text-zinc-400 text-[11px] font-medium\">Pengumuman</p>\n                <p className=\"font-bold text-zinc-100 mt-0.5\">{formatDateIndo(activity.announcementDate)}</p>\n              </div>\n\n              <div className=\"p-2.5 rounded-xl bg-[#0c0c0e] border border-zinc-800\">\n                <p className=\"text-zinc-400 text-[11px] font-medium\">Pelaksanaan</p>\n                <p className=\"font-bold text-zinc-100 mt-0.5\">{formatDateIndo(activity.eventDate)}</p>\n              </div>\n\n            </div>\n          </div>\n\n          {/* Detail & Benefit Teks */}\n          <div className=\"space-y-1.5\">\n            <h4 className=\"font-bold text-zinc-100 text-xs uppercase tracking-wider\">\n              Detail, Benefit & Catatan\n            </h4>\n            <div className=\"p-4 rounded-2xl bg-[#121215] border border-zinc-800 text-zinc-200 leading-relaxed whitespace-pre-line\">\n              {activity.details || \'Tidak ada catatan detail tambahan.\'}\n            </div>\n          </div>\n\n          {/* Tautan Berkas & Arsip (Google Drive / Submit / Berkas) */}\n          <div className=\"space-y-2\">\n            <h4 className=\"font-bold text-zinc-100 text-xs uppercase tracking-wider\">\n              Tautan Berkas & Pengarsipan Sertifikat\n            </h4>\n\n            <div className=\"space-y-2\">\n              \n              {/* Google Drive */}\n              {activity.driveUrl ? (\n                <div className=\"flex items-center justify-between p-3 rounded-xl bg-emerald-950/40 border border-emerald-800/80\">\n                  <div className=\"flex items-center gap-2 overflow-hidden mr-2\">\n                    <FolderGit2 className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                    <div>\n                      <p className=\"font-bold text-emerald-300 text-xs\">Drive Sertifikat / Hasil</p>\n                      <p className=\"text-[11px] text-emerald-400 truncate max-w-xs\">{activity.driveUrl}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-1 shrink-0\">\n                    <button\n                      onClick={() => copyToClipboard(activity.driveUrl!, \'drive\')}\n                      className=\"p-1.5 rounded-lg bg-[#0c0c0e] text-zinc-300 hover:bg-zinc-800 transition cursor-pointer\"\n                      title=\"Salin Tautan\"\n                    >\n                      {copiedLink === \'drive\' ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    </button>\n                    <a\n                      href={activity.driveUrl}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 transition\"\n                    >\n                      Buka Drive <ExternalLink className=\"w-3 h-3\" />\n                    </a>\n                  </div>\n                </div>\n              ) : null}\n\n              {/* Submission Url */}\n              {activity.submissionUrl ? (\n                <div className=\"flex items-center justify-between p-3 rounded-xl bg-indigo-950/40 border border-indigo-800/80\">\n                  <div className=\"flex items-center gap-2 overflow-hidden mr-2\">\n                    <FileCheck2 className=\"w-4 h-4 text-indigo-400 shrink-0\" />\n                    <div>\n                      <p className=\"font-bold text-indigo-300 text-xs\">Tautan Submit Karya</p>\n                      <p className=\"text-[11px] text-indigo-400 truncate max-w-xs\">{activity.submissionUrl}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-1 shrink-0\">\n                    <button\n                      onClick={() => copyToClipboard(activity.submissionUrl!, \'submit\')}\n                      className=\"p-1.5 rounded-lg bg-[#0c0c0e] text-zinc-300 hover:bg-zinc-800 transition cursor-pointer\"\n                      title=\"Salin Tautan\"\n                    >\n                      {copiedLink === \'submit\' ? <Check className=\"w-3.5 h-3.5 text-indigo-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    </button>\n                    <a\n                      href={activity.submissionUrl}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-500 transition\"\n                    >\n                      Buka Link <ExternalLink className=\"w-3 h-3\" />\n                    </a>\n                  </div>\n                </div>\n              ) : null}\n\n              {/* Documents Url */}\n              {activity.documentsUrl ? (\n                <div className=\"flex items-center justify-between p-3 rounded-xl bg-violet-950/40 border border-violet-800/80\">\n                  <div className=\"flex items-center gap-2 overflow-hidden mr-2\">\n                    <ExternalLink className=\"w-4 h-4 text-violet-400 shrink-0\" />\n                    <div>\n                      <p className=\"font-bold text-violet-300 text-xs\">Berkas Persyaratan</p>\n                      <p className=\"text-[11px] text-violet-400 truncate max-w-xs\">{activity.documentsUrl}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-1 shrink-0\">\n                    <button\n                      onClick={() => copyToClipboard(activity.documentsUrl!, \'docs\')}\n                      className=\"p-1.5 rounded-lg bg-[#0c0c0e] text-zinc-300 hover:bg-zinc-800 transition cursor-pointer\"\n                      title=\"Salin Tautan\"\n                    >\n                      {copiedLink === \'docs\' ? <Check className=\"w-3.5 h-3.5 text-violet-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    </button>\n                    <a\n                      href={activity.documentsUrl}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-violet-600 hover:bg-violet-500 transition\"\n                    >\n                      Buka Link <ExternalLink className=\"w-3 h-3\" />\n                    </a>\n                  </div>\n                </div>\n              ) : null}\n\n              {!activity.driveUrl && !activity.submissionUrl && !activity.documentsUrl && (\n                <div className=\"p-4 text-center text-xs text-zinc-500 bg-[#121215] rounded-xl border border-dashed border-zinc-800\">\n                  Belum ada tautan berkas atau sertifikat yang diunggah. Klik edit untuk menambahkan URL Google Drive.\n                </div>\n              )}\n\n            </div>\n          </div>\n\n          {/* Tags */}\n          {activity.tags && activity.tags.length > 0 && (\n            <div className=\"flex items-center gap-2 flex-wrap pt-2\">\n              <span className=\"text-xs font-semibold text-zinc-400 flex items-center gap-1\">\n                <Tag className=\"w-3.5 h-3.5\" /> Label Tag:\n              </span>\n              {activity.tags.map((tag, idx) => (\n                <span key={idx} className=\"px-2.5 py-1 rounded-lg text-xs font-medium bg-zinc-800 text-zinc-300 border border-zinc-700\">\n                  #{tag}\n                </span>\n              ))}\n            </div>\n          )}\n\n        </div>\n\n        {/* Modal Footer Actions */}\n        <div className=\"flex items-center justify-between p-6 border-t border-zinc-800/80 bg-[#121215]\">\n          <button\n            onClick={() => {\n              if (confirm(`Hapus kegiatan \"${activity.title}\"?`)) {\n                onDelete(activity.id);\n                onClose();\n              }\n            }}\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold text-rose-400 hover:bg-rose-950/40 transition cursor-pointer\"\n          >\n            <Trash2 className=\"w-4 h-4\" />\n            <span>Hapus Kegiatan</span>\n          </button>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => {\n                onClose();\n                onEdit(activity);\n              }}\n              className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-indigo-300 bg-indigo-950/80 border border-indigo-800 hover:bg-indigo-900 transition cursor-pointer\"\n            >\n              <Edit className=\"w-4 h-4\" />\n              <span>Edit Data</span>\n            </button>\n            <button\n              onClick={onClose}\n              className=\"px-4 py-2 rounded-xl text-xs font-semibold text-zinc-200 bg-zinc-800 hover:bg-zinc-700 transition cursor-pointer\"\n            >\n              Tutup\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </div>\n 