  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useRef } from \'react\';\nimport { \n  Plus, \n  FolderKanban, \n  LayoutDashboard, \n  TableProperties, \n  Database, \n  Download, \n  Upload, \n  RotateCcw,\n  Sparkles,\n  Tag\n} from \'lucide-react\';\nimport { exportDataAsJSON, importDataFromJSON, resetToSampleData } from \'../utils/storage\';\nimport { Activity, Category } from \'../types\';\n\ninterface NavbarProps {\n  activeTab: \'dashboard\' | \'table\' | \'prisma-spec\';\n  setActiveTab: (tab: \'dashboard\' | \'table\' | \'prisma-spec\') => void;\n  onOpenNewActivity: () => void;\n  onOpenCategoryManager: () => void;\n  selectedYear: string;\n  setSelectedYear: (year: string) => void;\n  availableYears: number[];\n  onDataRefresh: (activities: Activity[], categories: Category[]) => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  setActiveTab,\n  onOpenNewActivity,\n  onOpenCategoryManager,\n  selectedYear,\n  setSelectedYear,\n  availableYears,\n  onDataRefresh,\n}) => {\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const handleExport = () => {\n    const jsonStr = exportDataAsJSON();\n    const blob = new Blob([jsonStr], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = `kegiatan_kompetisi_${new Date().toISOString().slice(0, 10)}.json`;\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleImportFile = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    const reader = new FileReader();\n    reader.onload = (event) => {\n      try {\n        const result = event.target?.result as string;\n        const updated = importDataFromJSON(result);\n        onDataRefresh(updated.activities, updated.categories);\n        alert(\'Data berhasil diimpor!\');\n      } catch (err: any) {\n        alert(err.message || \'Gagal mengimpor file data.\');\n      }\n    };\n    reader.readAsText(file);\n    e.target.value = \'\';\n  };\n\n  const handleResetData = () => {\n    if (confirm(\'Apakah Anda yakin ingin mengembalikan data ke sampel awal? Data yang ditambahkan sendiri akan diganti.\')) {\n      const reset = resetToSampleData();\n      onDataRefresh(reset.activities, reset.categories);\n    }\n  };\n\n  return (\n    <header className=\"bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-30 shadow-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16 gap-4\">\n          \n          {/* Logo & Brand Title */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center shadow-md shadow-blue-500/20\">\n              <FolderKanban className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"font-bold text-slate-900 dark:text-white text-lg tracking-tight leading-tight\">\n                  TrackActivity\n                </h1>\n                <span className=\"hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800\">\n                  <Sparkles className=\"w-3 h-3 mr-1\" />\n                  Full-Stack\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400 hidden sm:block\">\n                Pelacak Kegiatan, Kompetisi & Arsip Berkas\n              </p>\n            </div>\n          </div>\n\n          {/* Nav Tabs */}\n          <nav className=\"flex items-center bg-slate-100 dark:bg-slate-800/80 p-1 rounded-xl border border-slate-200/60 dark:border-slate-700/60\">\n            <button\n              id=\"btn-tab-dashboard\"\n              onClick={() => setActiveTab(\'dashboard\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all ${\n                activeTab === \'dashboard\'\n                  ? \'bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n              }`}\n            >\n              <LayoutDashboard className=\"w-4 h-4\" />\n              <span>Dashboard</span>\n            </button>\n            <button\n              id=\"btn-tab-table\"\n              onClick={() => setActiveTab(\'table\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all ${\n                activeTab === \'table\'\n                  ? \'bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n              }`}\n            >\n              <TableProperties className=\"w-4 h-4\" />\n              <span>Daftar & Filter</span>\n            </button>\n            <button\n              id=\"btn-tab-prisma\"\n              onClick={() => setActiveTab(\'prisma-spec\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all ${\n                activeTab === \'prisma-spec\'\n                  ? \'bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 shadow-xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n              }`}\n            >\n              <Database className=\"w-4 h-4 text-indigo-500\" />\n              <span className=\"hidden md:inline\">Next.js & Prisma</span>\n              <span className=\"md:hidden\">Prisma</span>\n            </button>\n          </nav>\n\n          {/* Action Buttons & Year Selector */}\n          <div className=\"flex items-center gap-2\">\n            \n            {/* Filter Tahun */}\n            <div className=\"hidden lg:flex items-center gap-1 bg-slate-100 dark:bg-slate-800 text-xs px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700\">\n              <span className=\"text-slate-500 font-medium\">Tahun:</span>\n              <select\n                id=\"select-navbar-year\"\n                value={selectedYear}\n                onChange={(e) => setSelectedYear(e.target.value)}\n                className=\"bg-transparent font-semibold text-slate-800 dark:text-slate-200 outline-none cursor-pointer\"\n              >\n                <option value=\"ALL\">Semua</option>\n                {availableYears.map((y) => (\n                  <option key={y} value={y.toString()}>\n                    {y}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Manage Categories */}\n            <button\n              id=\"btn-manage-categories\"\n              onClick={onOpenCategoryManager}\n              title=\"Kelola Kategori\"\n              className=\"hidden md:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition\"\n            >\n              <Tag className=\"w-3.5 h-3.5\" />\n              <span>Kategori</span>\n            </button>\n\n            {/* Backup/Import Menu */}\n            <div className=\"hidden sm:flex items-center gap-1\">\n              <button\n                id=\"btn-export-json\"\n                onClick={handleExport}\n                title=\"Ekspor Backup Data JSON\"\n                className=\"p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition\"\n              >\n                <Download className=\"w-4 h-4\" />\n              </button>\n              <button\n                id=\"btn-import-json\"\n                onClick={() => fileInputRef.current?.click()}\n                title=\"Impor Backup Data JSON\"\n                className=\"p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition\"\n              >\n                <Upload className=\"w-4 h-4\" />\n              </button>\n              <input\n                ref={fileInputRef}\n                type=\"file\"\n                accept=\".json\"\n                onChange={handleImportFile}\n                className=\"hidden\"\n              />\n              <button\n                id=\"btn-reset-data\"\n                onClick={handleResetData}\n                title=\"Reset ke Data Sampel\"\n                className=\"p-2 rounded-xl text-slate-500 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition\"\n              >\n                <RotateCcw className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {/* Primary CRUD Add Button */}\n            <button\n              id=\"btn-add-activity\"\n              onClick={onOpenNewActivity}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 active:scale-95 shadow-md shadow-blue-500/20 transition-all cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>Tambah Kegiatan</span>\n            </button>\n\n          </div>\n\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
