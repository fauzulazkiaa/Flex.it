    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useMemo } from \'react\';\nimport { Activity, Category } from \'./types\';\nimport { \n  getStoredActivities, \n  getStoredCategories, \n  saveActivities, \n  saveCategories \n} from \'./utils/storage\';\nimport { Navbar } from \'./components/Navbar\';\nimport { StatCards } from \'./components/StatCards\';\nimport { AnalyticsCharts } from \'./components/AnalyticsCharts\';\nimport { UpcomingDeadlines } from \'./components/UpcomingDeadlines\';\nimport { ActivityTable } from \'./components/ActivityTable\';\nimport { ActivityFormModal } from \'./components/ActivityFormModal\';\nimport { ActivityDetailModal } from \'./components/ActivityDetailModal\';\nimport { CategoryManagerModal } from \'./components/CategoryManagerModal\';\nimport { NextjsPrismaView } from \'./components/NextjsPrismaView\';\nimport { Trophy, Sparkles, Filter, Plus, ArrowUpRight } from \'lucide-react\';\n\nexport default function App() {\n  const [activities, setActivities] = useState<Activity[]>([]);\n  const [categories, setCategories] = useState<Category[]>([]);\n  const [activeTab, setActiveTab] = useState<\'dashboard\' | \'table\' | \'prisma-spec\'>(\'dashboard\');\n  const [selectedYear, setSelectedYear] = useState<string>(\'2026\');\n\n  // Modal States\n  const [isFormOpen, setIsFormOpen] = useState(false);\n  const [editingActivity, setEditingActivity] = useState<Activity | null>(null);\n\n  const [selectedActivity, setSelectedActivity] = useState<Activity | null>(null);\n\n  const [isCategoryManagerOpen, setIsCategoryManagerOpen] = useState(false);\n\n  // Load Initial Data from localStorage\n  useEffect(() => {\n    const loadedActs = getStoredActivities();\n    const loadedCats = getStoredCategories();\n    setActivities(loadedActs);\n    setCategories(loadedCats);\n  }, []);\n\n  // Save changes to localStorage whenever activities or categories change\n  const handleSaveActivities = (newActivities: Activity[]) => {\n    setActivities(newActivities);\n    saveActivities(newActivities);\n  };\n\n  const handleSaveCategories = (newCategories: Category[]) => {\n    setCategories(newCategories);\n    saveCategories(newCategories);\n  };\n\n  // List Available Years from Data\n  const availableYears = useMemo(() => {\n    const setYears = new Set<number>();\n    activities.forEach(a => setYears.add(a.year || new Date().getFullYear()));\n    setYears.add(new Date().getFullYear());\n    return Array.from(setYears).sort((a, b) => b - a);\n  }, [activities]);\n\n  // CRUD Handlers\n  const handleCreateOrUpdateActivity = (\n    data: Omit<Activity, \'id\' | \'createdAt\' | \'updatedAt\'> & { id?: string }\n  ) => {\n    const now = new Date().toISOString();\n\n    if (data.id) {\n      // Update\n      const updated = activities.map((a) =>\n        a.id === data.id\n          ? {\n              ...a,\n              ...data,\n              updatedAt: now,\n            }\n          : a\n      );\n      handleSaveActivities(updated);\n      if (selectedActivity?.id === data.id) {\n        setSelectedActivity(updated.find(a => a.id === data.id) || null);\n      }\n    } else {\n      // Create\n      const newAct: Activity = {\n        ...data,\n        id: `act-${Date.now()}`,\n        createdAt: now,\n        updatedAt: now,\n      };\n      handleSaveActivities([newAct, ...activities]);\n    }\n\n    setEditingActivity(null);\n  };\n\n  const handleDeleteActivity = (id: string) => {\n    const filtered = activities.filter((a) => a.id !== id);\n    handleSaveActivities(filtered);\n    if (selectedActivity?.id === id) {\n      setSelectedActivity(null);\n    }\n  };\n\n  const handleUpdateStatus = (id: string, newStatus: any) => {\n    const updated = activities.map((a) =>\n      a.id === id ? { ...a, status: newStatus, updatedAt: new Date().toISOString() } : a\n    );\n    handleSaveActivities(updated);\n    if (selectedActivity?.id === id) {\n      setSelectedActivity(prev => prev ? { ...prev, status: newStatus } : null);\n    }\n  };\n\n  const handleSaveCategory = (catToSave: Category) => {\n    const exists = categories.some((c) => c.id === catToSave.id);\n    let updated: Category[];\n    if (exists) {\n      updated = categories.map((c) => (c.id === catToSave.id ? catToSave : c));\n    } else {\n      updated = [...categories, catToSave];\n    }\n    handleSaveCategories(updated);\n  };\n\n  const handleDeleteCategory = (catId: string) => {\n    const updated = categories.filter((c) => c.id !== catId);\n    handleSaveCategories(updated);\n  };\n\n  const handleDataRefresh = (newActs: Activity[], newCats: Category[]) => {\n    setActivities(newActs);\n    setCategories(newCats);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-100/70 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans transition-colors pb-16\">\n      \n      {/* Navbar Header */}\n      <Navbar\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        onOpenNewActivity={() => {\n          setEditingActivity(null);\n          setIsFormOpen(true);\n        }}\n        onOpenCategoryManager={() => setIsCategoryManagerOpen(true)}\n        selectedYear={selectedYear}\n        setSelectedYear={setSelectedYear}\n        availableYears={availableYears}\n        onDataRefresh={handleDataRefresh}\n      />\n\n      {/* Main Container */}\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 space-y-6\">\n        \n        {/* Tab 1: Dashboard Utama */}\n        {activeTab === \'dashboard\' && (\n          <div className=\"space-y-6 animate-in fade-in duration-300\">\n            \n            {/* Banner Header Dashboard */}\n            <div className=\"bg-gradient-to-r from-blue-700 via-indigo-700 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden\">\n              <div className=\"relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                <div className=\"space-y-2 max-w-2xl\">\n                  <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-blue-200 text-xs font-semibold backdrop-blur-md border border-white/10\">\n                    <Sparkles className=\"w-3.5 h-3.5\" /> Pelacak Portfolio & Program Kegiatan\n                  </div>\n                  <h2 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight\">\n                    Dashboard Kompetisi & Program {selectedYear !== \'ALL\' ? selectedYear : \'\'}\n                  </h2>\n                  <p className=\"text-xs sm:text-sm text-blue-100/90 leading-relaxed\">\n                    Pantau status pendaftaran, tenggat waktu terdekat, success rate, dan tautan arsip sertifikat Google Drive dalam satu tempat yang terorganisir.\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-2 shrink-0\">\n                  <button\n                    onClick={() => {\n                      setEditingActivity(null);\n                      setIsFormOpen(true);\n                    }}\n                    className=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl font-bold text-xs sm:text-sm text-blue-900 bg-white hover:bg-blue-50 shadow-lg transition active:scale-95 cursor-pointer\"\n                  >\n                    <Plus className=\"w-4 h-4\" />\n                    Tambah Kegiatan\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            {/* Stat Cards (Total, Success Rate, Upcoming, Status) */}\n            <StatCards activities={activities} selectedYear={selectedYear} />\n\n            {/* Upcoming Deadlines section */}\n            <UpcomingDeadlines\n              activities={activities}\n              categories={categories}\n              onSelectActivity={(act) => setSelectedActivity(act)}\n              onOpenTableWithFilter={() => setActiveTab(\'table\')}\n            />\n\n            {/* Analytics Charts (Pie Chart Distribusi & Bar Chart Status) */}\n            <AnalyticsCharts\n              activities={activities}\n              categories={categories}\n              selectedYear={selectedYear}\n            />\n\n            {/* Quick Activity Table Ringkas */}\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"font-bold text-slate-900 dark:text-white text-lg\">\n                  Ringkasan Semua Kegiatan ({activities.length})\n                </h3>\n                <button\n                  onClick={() => setActiveTab(\'table\')}\n                  className=\"text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1 cursor-pointer\"\n                >\n                  Buka Tabel Lengkap <ArrowUpRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n\n              <ActivityTable\n                activities={activities}\n                categories={categories}\n                onSelectActivity={(act) => setSelectedActivity(act)}\n                onEditActivity={(act) => {\n                  setEditingActivity(act);\n                  setIsFormOpen(true);\n                }}\n                onDeleteActivity={handleDeleteActivity}\n                onOpenNewActivity={() => {\n                  setEditingActivity(null);\n                  setIsFormOpen(true);\n                }}\n                selectedYearNav={selectedYear}\n              />\n            </div>\n\n          </div>\n        )}\n\n        {/* Tab 2: Tabel & Filter Kegiatan Lengkap */}\n        {activeTab === \'table\' && (\n          <div className=\"space-y-4 animate-in fade-in duration-300\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n              <div>\n                <h2 className=\"text-2xl font-extrabold text-slate-900 dark:text-white\">\n                  Daftar & Pengarsipan Berkas Kegiatan\n                </h2>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                  Urutkan dan saring kegiatan berdasarkan kategori, status, dan rentang waktu.\n                </p>\n              </div>\n            </div>\n\n            <ActivityTable\n              activities={activities}\n              categories={categories}\n              onSelectActivity={(act) => setSelectedActivity(act)}\n              onEditActivity={(act) => {\n                setEditingActivity(act);\n                setIsFormOpen(true);\n              }}\n              onDeleteActivity={handleDeleteActivity}\n              onOpenNewActivity={() => {\n                setEditingActivity(null);\n                setIsFormOpen(true);\n              }}\n              selectedYearNav={selectedYear}\n            />\n          </div>\n        )}\n\n        {/* Tab 3: Prisma Schema & Next.js Architecture View */}\n        {activeTab === \'prisma-spec\' && (\n          <div className=\"animate-in fade-in duration-300\">\n            <NextjsPrismaView />\n          </div>\n        )}\n\n      </main>\n\n      {/* MODALS */}\n      {/* 1. CRUD Form Modal */}\n      <ActivityFormModal\n        isOpen={isFormOpen}\n        onClose={() => setIsFormOpen(false)}\n        onSave={handleCreateOrUpdateActivity}\n        initialData={editingActivity}\n        categories={categories}\n      />\n\n      {/* 2. Detail Activity Modal */}\n      <ActivityDetailModal\n        activity={selectedActivity}\n        onClose={() => setSelectedActivity(null)}\n        categories={categories}\n        onEdit={(act) => {\n          setEditingActivity(act);\n          setIsFormOpen(true);\n        }}\n        onDelete={handleDeleteActivity}\n        onUpdateStatus={handleUpdateStatus}\n      />\n\n      {/* 3. Category Manager Modal */}\n      <CategoryManagerModal\n        isOpen={isCategoryManagerOpen}\n        onClose={() => setIsCategoryManagerOpen(false)}\n        categories={categories}\n        onSaveCategory={handleSaveCategory}\n        onDeleteCategory={handleDeleteCategory}\n      />\n\n    </div>\n  );\n}\n"
    }
    diff {
      end_line: 8
