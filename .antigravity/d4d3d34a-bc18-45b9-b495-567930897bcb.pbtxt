ctivity.title}\n                      </h4>\n                      {categoryObj && (\n                        <span className=\"px-2 py-0.5 rounded-md text-[11px] font-medium bg-zinc-800 text-zinc-300 border border-zinc-700\">\n                          {categoryObj.name}\n                        </span>\n                      )}\n                    </div>\n\n                    <div className=\"flex items-center gap-3 text-xs text-zinc-400 mt-1\">\n                      {activity.organizer && <span>Penyelenggara: {activity.organizer}</span>}\n                      <span className=\"flex items-center gap-1 text-zinc-300 font-medium\">\n                        <Calendar className=\"w-3.5 h-3.5 text-zinc-400\" />\n                        Deadline: {formatDateIndo(activity.regDeadline)}\n                      </span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center justify-between sm:justify-end gap-3 shrink-0\">\n                  <span className={`px-2.5 py-1 rounded-lg text-xs font-medium border ${statusStyle.bg} ${statusStyle.text} ${statusStyle.border}`}>\n                    {statusStyle.label}\n                  </span>\n                  {countdownBadge}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      )}\n    </div>\n  );"
