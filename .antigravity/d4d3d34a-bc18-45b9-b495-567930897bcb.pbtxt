      target_content: "  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n      \n      {/* Chart 1: Pie Chart Distribusi Kategori */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-2 rounded-xl bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400\">\n              <PieIcon className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"font-bold text-slate-900 dark:text-white text-base\">\n                Distribusi Kegiatan per Kategori\n              </h3>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                Persentase fokus program yang diikuti\n              </p>\n            </div>\n          </div>\n          <span className=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300\">\n            {pieData.reduce((acc, curr) => acc + curr.value, 0)} Total\n          </span>\n        </div>\n\n        {pieData.length === 0 ? (\n          <div className=\"h-64 flex items-center justify-center text-xs text-slate-400\">\n            Belum ada data kegiatan untuk kategori ini.\n          </div>\n        ) : (\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <PieChart>\n                <Pie\n                  data={pieData}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  innerRadius={55}\n                  outerRadius={85}\n                  paddingAngle={4}\n                  dataKey=\"value\"\n                  label={({ name, percent }) => `${name} (${(percent * 100).toFixed(0)}%)`}\n                  labelLine={false}\n                >\n                  {pieData.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={entry.color} />\n                  ))}\n                </Pie>\n                <Tooltip \n                  contentStyle={{ \n                    backgroundColor: \'rgba(15, 23, 42, 0.9)\', \n                    border: \'none\', \n                    borderRadius: \'12px\',\n                    color: \'#fff\',\n                    fontSize: \'12px\'\n                  }} \n                  formatter={(value: number) => [`${value} Kegiatan`, \'Jumlah\']}\n                />\n              </PieChart>\n            </ResponsiveContainer>\n          </div>\n        )}\n\n        {/* Legend Custom */}\n        <div className=\"mt-3 grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs border-t border-slate-100 dark:border-slate-800 pt-3\">\n          {pieData.map((item, i) => (\n            <div key={i} className=\"flex items-center gap-1.5\">\n              <div className=\"w-2.5 h-2.5 rounded-full\" style={{ backgroundColor: item.color }} />\n              <span className=\"text-slate-600 dark:text-slate-400 truncate\">{item.name}:</span>\n              <span className=\"font-semibold text-slate-900 dark:text-white\">{item.value}</span>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Chart 2: Bar Chart Breakdown Status per Kategori */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-2 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400\">\n              <BarChart3 className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"font-bold text-slate-900 dark:text-white text-base\">\n                Status Capaian per Kategori\n              </h3>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                Perbandingan pendaftaran, lolos, dan kelulusan\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {barData.length === 0 ? (\n          <div className=\"h-64 flex items-center justify-center text-xs text-slate-400\">\n            Belum ada data untuk ditampilkan dalam grafik.\n          </div>\n        ) : (\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart data={barData} margin={{ top: 10, right: 10, left: -20, bottom: 20 }}>\n                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#33415520\" />\n                <XAxis \n                  dataKey=\"name\" \n                  tick={{ fontSize: 11, fill: \'#64748B\' }}\n                  angle={-15}\n                  textAnchor=\"end\"\n                  interval={0}\n                />\n                <YAxis allowDecimals={false} tick={{ fontSize: 11, fill: \'#64748B\' }} />\n                <Tooltip \n                  contentStyle={{ \n                    backgroundColor: \'rgba(15, 23, 42, 0.95)\', \n                    borderRadius: \'12px\', \n                    color: \'#fff\', \n                    border: \'none\',\n                    fontSize: \'12px\'\n                  }} \n                />\n                <Bar dataKey=\"Belum Daftar\" stackId=\"a\" fill=\"#94A3B8\" radius={[0, 0, 0, 0]} />\n                <Bar dataKey=\"Sudah Daftar\" stackId=\"a\" fill=\"#3B82F6\" radius={[0, 0, 0, 0]} />\n                <Bar dataKey=\"Lolos\" stackId=\"a\" fill=\"#10B981\" radius={[0, 0, 0, 0]} />\n                <Bar dataKey=\"Tidak Lolos\" stackId=\"a\" fill=\"#F43F5E\" radius={[0, 0, 0, 0]} />\n                <Bar dataKey=\"Selesai\" stackId=\"a\" fill=\"#14B8A6\" radius={[4, 4, 0, 0]} />\n              </BarChart>\n            </ResponsiveContainer>\n          </div>\n        )}\n\n        <div className=\"mt-3 flex flex-wrap gap-3 justify-center text-xs border-t border-slate-100 dark:border-slate-800 pt-3\">\n          <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded bg-slate-400\" /> Belum</span>\n          <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded bg-blue-500\" /> Sudah Daftar</span>\n          <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded bg-emerald-500\" /> Lolos</span>\n          <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded bg-rose-500\" /> Tidak Lolos</span>\n          <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded bg-teal-500\" /> Selesai</span>\n        </div>\n\n      </div>\n\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n      \n      {/* Chart 1: Pie Chart Distribusi Kategori */}\n      <div className=\"bg-[#0c0c0e] rounded-2xl p-5 border border-zinc-800/80 shadow-lg shadow-black/40 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-2 rounded-xl bg-violet-500/10 border border-violet-500/20 text-violet-400\">\n              <PieIcon className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"font-bold text-zinc-100 text-base\">\n                Distribusi Kegiatan per Kategori\n              </h3>\n              <p className=\"text-xs text-zinc-400\">\n                Persentase fokus program yang diikuti\n              </p>\n            </div>\n          </div>\n          <span className=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-zinc-900 text-zinc-300 border border-zinc-800\">\n            {pieData.reduce((acc, curr) => acc + curr.value, 0)} Total\n          </span>\n        </div>\n\n        {pieData.length === 0 ? (\n          <div className=\"h-64 flex items-center justify-center text-xs text-zinc-500\">\n            Belum ada data kegiatan untuk kategori ini.\n          </div>\n        ) : (\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <PieChart>\n                <Pie\n                  data={pieData}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  innerRadius={55}\n                  outerRadius={85}\n                  paddingAngle={4}\n                  dataKey=\"value\"\n                  label={({ name, percent }) => `${name} (${(percent * 100).toFixed(0)}%)`}\n                  labelLine={false}\n                >\n                  {pieData.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={entry.color} />\n                  ))}\n                </Pie>\n                <Tooltip \n                  contentStyle={{ \n                    backgroundColor: \'#121215\', \n                    border: \'1px solid #27272a\', \n                    borderRadius: \'12px\',\n                    color: \'#f4f4f5\',\n                    fontSize: \'12px\'\n                  }} \n                  formatter={(value: number) => [`${value} Kegiatan`, \'Jumlah\']}\n                />\n              </PieChart>\n            </ResponsiveContainer>\n          </div>\n        )}\n\n        {/* Legend Custom */}\n        <div className=\"mt-3 grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs border-t border-zinc-800/80 pt-3\">\n          {pieData.map((item, i) => (\n            <div key={i} className=\"flex items-center gap-1.5\">\n              <div className=\"w-2.5 h-2.5 rounded-full\" style={{ backgroundColor: item.color }} />\n              <span className=\"text-zinc-400 truncate\">{item.name}:</span>\n              <span className=\"font-semibold text-zinc-100\">{item.value}</span>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Chart 2: Bar Chart Breakdown Status per Kategori */}\n      <div className=\"bg-[#0c0c0e] rounded-2xl p-5 border border-zinc-800/80 shadow-lg shadow-black/40 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-2 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400\">\n              <BarChart3 className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"font-bold text-zinc-100 text-base\">\n                Status Capaian per Kategori\n              </h3>\n              <p className=\"text-xs text-zinc-400\">\n                Perbandingan pendaftaran, lolos, dan kelulusan\n              </p>\n         