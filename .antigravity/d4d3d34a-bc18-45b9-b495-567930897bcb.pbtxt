    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PRISMA_SCHEMA_CODE, NEXTJS_FOLDER_STRUCTURE, SERVER_ACTION_EXAMPLE } from \'../data/prismaSchema\';\nimport { Database, FolderTree, Server, Copy, Check, Code2, Sparkles } from \'lucide-react\';\n\nexport const NextjsPrismaView: React.FC = () => {\n  const [activeTab, setActiveTab] = useState<\'prisma\' | \'structure\' | \'server-code\'>(\'prisma\');\n  const [copiedTab, setCopiedTab] = useState<string | null>(null);\n\n  const copyCode = (code: string, tabName: string) => {\n    navigator.clipboard.writeText(code);\n    setCopiedTab(tabName);\n    setTimeout(() => setCopiedTab(null), 2000);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Banner Intro */}\n      <div className=\"bg-gradient-to-r from-indigo-900 via-slate-900 to-blue-900 rounded-3xl p-6 text-white shadow-xl relative overflow-hidden border border-indigo-700/40\">\n        <div className=\"relative z-10 space-y-2\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-semibold border border-indigo-400/30\">\n            <Sparkles className=\"w-3.5 h-3.5\" /> Output Spesifikasi Full-Stack Developer\n          </div>\n          <h2 className=\"text-2xl font-extrabold tracking-tight\">\n            Prisma Schema & Next.js App Router Architecture\n          </h2>\n          <p className=\"text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed\">\n            Spesifikasi lengkap skema Prisma ORM (`Activity` & `Category`), struktur folder Next.js (App Router), dan implementasi Server Components untuk Supabase/PostgreSQL.\n          </p>\n        </div>\n      </div>\n\n      {/* Tabs Switcher */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-2 flex items-center gap-2\">\n        <button\n          onClick={() => setActiveTab(\'prisma\')}\n          className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition ${\n            activeTab === \'prisma\'\n              ? \'bg-indigo-600 text-white shadow-md shadow-indigo-500/20\'\n              : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800\'\n          }`}\n        >\n          <Database className=\"w-4 h-4\" />\n          1. Prisma Schema (schema.prisma)\n        </button>\n        <button\n          onClick={() => setActiveTab(\'structure\')}\n          className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition ${\n            activeTab === \'structure\'\n              ? \'bg-indigo-600 text-white shadow-md shadow-indigo-500/20\'\n              : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800\'\n          }`}\n        >\n          <FolderTree className=\"w-4 h-4\" />\n          2. Struktur Folder Next.js\n        </button>\n        <button\n          onClick={() => setActiveTab(\'server-code\')}\n          className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition ${\n            activeTab === \'server-code\'\n              ? \'bg-indigo-600 text-white shadow-md shadow-indigo-500/20\'\n              : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800\'\n          }`}\n        >\n          <Server className=\"w-4 h-4\" />\n          3. Server Components & Query Filter\n        </button>\n      </div>\n\n      {/* Tab Code Box */}\n      <div className=\"bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden shadow-xl\">\n        \n        <div className=\"flex items-center justify-between px-5 py-3 bg-slate-900 border-b border-slate-800\">\n          <div className=\"flex items-center gap-2 text-xs font-mono text-slate-300\">\n            <Code2 className=\"w-4 h-4 text-indigo-400\" />\n            {activeTab === \'prisma\' && \'prisma/schema.prisma\'}\n            {activeTab === \'structure\' && \'Next.js App Router Tree\'}\n            {activeTab === \'server-code\' && \'app/activities/page.tsx\'}\n          </div>\n\n          <button\n            onClick={() => {\n              const codeToCopy = \n                activeTab === \'prisma\' ? PRISMA_SCHEMA_CODE :\n                activeTab === \'structure\' ? NEXTJS_FOLDER_STRUCTURE :\n                SERVER_ACTION_EXAMPLE;\n              copyCode(codeToCopy, activeTab);\n            }}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition\"\n          >\n            {copiedTab === activeTab ? (\n              <>\n                <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> Tersalin!\n              </>\n            ) : (\n              <>\n                <Copy className=\"w-3.5 h-3.5\" /> Salin Kode\n              </>\n            )}\n          </button>\n        </div>\n\n        <pre className=\"p-5 font-mono text-xs sm:text-sm text-slate-200 overflow-x-auto leading-relaxed max-h-[500px]\">\n          {activeTab === \'prisma\' && PRISMA_SCHEMA_CODE}\n          {activeTab === \'structure\' && NEXTJS_FOLDER_STRUCTURE}\n          {activeTab === \'server-code\' && SERVER_ACTION_EXAMPLE}\n        </pre>\n      </div>\n\n    </div>\n  );\n};\n"
    }
